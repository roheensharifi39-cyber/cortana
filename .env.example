# Copy this file to .env and fill in what you have. Everything works with no keys at all.

# --- Agent brains (Gemini) ---
# Get a free key at https://aistudio.google.com  → "Get API key"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# auto = Gemini if a key is set, else offline templates. Options: auto | gemini | offline
LLM_MODE=auto

# --- ANS ---
# sim = local ANS simulator (default). godaddy = GoDaddy's hosted ANS API.
ANS_BACKEND=sim

# Only for ANS_BACKEND=godaddy.
# OTE (test): https://api.ote-godaddy.com   Production: https://api.godaddy.com
# Pick one on purpose — never let the app choose for you.
ANS_API_URL=https://api.ote-godaddy.com
# GoDaddy's ANS REST catalog lists PAT auth: sent as `Authorization: Bearer <pat>`.
ANS_PAT=
# Transparency log base URL: where status tokens, receipts and root keys come from.
# Until this is set, the Trust Gate reports standing as UNVERIFIED (which fails closed).
ANS_TLOG_URL=
# The ANS identity CA root to pin. A chain handed over by the agent you are checking is not
# a trust anchor. Ask the sponsor where the canonical root lives.
ANS_CA_BUNDLE_PATH=

# Legacy key:secret scheme. Only set ANS_AUTH_MODE=sso-key if the sponsor says PAT is wrong.
ANS_AUTH_MODE=pat
ANS_API_KEY=
ANS_API_SECRET=

# The real domain we control. Leave it empty and every agent keeps its own made-up domain
# (brandstudio.xyz and friends) — the right shape for the story, and impossible to register
# because we do not own them. Set it and all five move to subdomains of a domain we can
# actually prove control of, which is what live ANS registration needs.
#   unset  ->  ans://v1.0.0.sitebuilder.webforge.xyz
#   set    ->  ans://v1.0.0.webforge.getcortex.vip
# ANS_DOMAIN=getcortex.vip

# Where each agent is actually reachable. Only needed once they are deployed somewhere real:
# ANS hands these URLs to whoever is hiring, and an agent answering from anywhere else is
# refused by policy. Must match what was registered.
# AGENT_ENDPOINT_COMMANDER=https://commander.getcortex.vip
# AGENT_ENDPOINT_BRAND=https://brand.getcortex.vip
# AGENT_ENDPOINT_WEBFORGE=https://webforge.getcortex.vip
# AGENT_ENDPOINT_SITESMITH=https://sitesmith.getcortex.vip
# AGENT_ENDPOINT_COMPLIANCE=https://compliance.getcortex.vip

# --- Demo ---
# Seconds of deliberate pause between steps so the audience can follow. 0 for fastest.
DEMO_PACE=1.0

# --- Deployment overrides (leave empty to run everything locally) ---
# HUB_URL=http://127.0.0.1:8000
# ANS_SIM_URL=http://127.0.0.1:8100
# AGENT_ENDPOINT_BRAND=https://agent.brandstudio.xyz
